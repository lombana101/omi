# Copy to /etc/omi-personal-intelligence/personal-intelligence.env on Ubuntu.
# The live file must be owned by root:root, mode 0600. Never commit its values.
# Empty required values make startup fail closed.

# Opaque identifier configured identically in the iOS privacy app. Use 1-200
# characters from A-Z, a-z, 0-9, dot, underscore, colon, at-sign, and hyphen.
# Prefer a random identifier rather than an email address.
PIS_OWNER_UID=

# Use 24-256 URL-safe characters from A-Z, a-z, 0-9, dot, underscore, tilde,
# and hyphen. Generate 32 random bytes (64 lowercase hex characters recommended).
# Store the same value only in this protected file and the iOS Keychain.
PIS_API_TOKEN=

# The API deliberately refuses non-loopback listeners. Tailscale Serve is the
# only proposed TLS ingress.
PIS_LISTEN_HOST=127.0.0.1
PIS_LISTEN_PORT=8792
PIS_STATE_PATH=/var/lib/omi-personal-intelligence/operations.sqlite3
PIS_CONFIRMATION_TTL_SECONDS=900

# TimeTree is disabled until both credentials have been entered. Its private API
# is unsupported by TimeTree and may change without notice.
TIMETREE_INTEGRATION_ENABLED=false
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
TIMETREE_DEFAULT_CALENDAR_ID=
TIMETREE_PREFER_FOR_GENERIC_CALENDAR=false
TIMETREE_TIMEOUT_SECONDS=20
TIMETREE_REQUESTS_PER_SECOND=10

# Local intelligence is disabled until an installed Ollama model is selected.
# The service rejects a non-loopback base URL so private text stays on Ubuntu.
PIS_LLM_ENABLED=false
PIS_LLM_BASE_URL=http://127.0.0.1:11434
PIS_LLM_MODEL=
PIS_LLM_TIMEOUT_SECONDS=45
